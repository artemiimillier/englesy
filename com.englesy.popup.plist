<?xml version="1.0" encoding="UTF-8"?>
<!--
  Автозапуск ENGLESY при входе в систему.
  Установка:
    cp com.englesy.popup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.englesy.popup.plist
  Остановить/удалить:
    launchctl unload ~/Library/LaunchAgents/com.englesy.popup.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.englesy.popup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/artemiimiller/Documents/ENGLESY &amp;&amp; npm start</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/englesy.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/englesy.err.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Автозапуск ENGLESY при входе в систему (после включения компьютера).
  Установка:
    cp com.englesy.popup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.englesy.popup.plist
  Остановить/удалить автозапуск:
    launchctl unload ~/Library/LaunchAgents/com.englesy.popup.plist
    rm ~/Library/LaunchAgents/com.englesy.popup.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.englesy.popup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/artemiimiller/Documents/ENGLESY/bin/start-englesy.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Перезапускать только при сбое, а не после ручного «Выхода» из трея. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/englesy.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/englesy.err.log</string>
</dict>
</plist>

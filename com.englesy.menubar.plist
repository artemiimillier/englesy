<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ENGLESY menu-bar launcher launchd agent.
  Shows the menu-bar icon at login + serves the app + auto-opens the trainer in Chrome
  at the scheduled times. Use THIS instead of com.englesy.web.plist (don't load both —
  they'd both schedule). Install:

    cp com.englesy.menubar.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.englesy.web.plist 2>/dev/null
    launchctl unload ~/Library/LaunchAgents/com.englesy.menubar.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.englesy.menubar.plist

  Stop:  launchctl unload ~/Library/LaunchAgents/com.englesy.menubar.plist
  Logs:  /tmp/englesy-menubar.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.englesy.menubar</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/artemiimiller/Documents/ENGLESY/src/run-menubar.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/artemiimiller/Documents/ENGLESY</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/englesy-menubar.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/englesy-menubar.log</string>
</dict>
</plist>
